{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EKSPodIdentityManagement",
      "Effect": "Allow",
      "Action": [
        "eks:ListPodIdentityAssociations",
        "eks:CreatePodIdentityAssociation",
        "eks:DeletePodIdentityAssociation"
      ],
      "Resource": ["*"]
    },
    {
      "Sid": "EC2",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances"],
      "Resource": ["*"]
    },
    {
      "Sid": "IAM",
      "Effect": "Allow",
      "Action": ["iam:GetRole"],
      "Resource": [
        "arn:aws-us-gov:iam::103448924380:role/DeployerV2"
      ]
    },
    {
      "Sid": "IAMPassRoleforPodIdentity",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": [
        "arn:aws-us-gov:iam::103448924380:role/DeployerV2"
      ]
    }
  ]
}
